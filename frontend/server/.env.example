# AI 助手配置模板：复制为 .env 放在 ai-editor.exe 同目录
# 也可不填 .env，启动后在 AI 面板右上角齿轮设置里填（面板设置优先级更高）

# 任意 OpenAI 兼容 API 地址（DeepSeek / 豆包 / GLM / OpenAI…，自动剥掉 /v1 等版本尾巴）
AI_API_URL=https://api.deepseek.com

# API Key
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名
AI_MODEL=deepseek-chat

# 服务端口（默认 8090）
PORT=8090

# 新建/打开文档的对外地址（OnlyOffice 服务器用来下载这些文档）
# DS 与本服务同机部署时留空即可；DS 在 bridge 容器里时写 http://172.17.0.1:8090
DOC_PUBLIC_ORIGIN=

# === DSH AI（本机 agent harness，仅经官方 CLI headless 调用）===
# 完整命令行模板（按空格分词，服务会自动追加 --profile headless / --session-id <id> / - ）
# 默认直接 `dsh`（Windows 生产 / Linux 服务器通用）；仅 WSL 开发机（node 在 Linux、dsh 在 Windows）需要显式指定 interop：
#DSH_CMD=cmd.exe /c dsh
# dsh 执行工作目录：默认用户主目录；WSL 下指向 C 盘用户目录可避开 UNC 路径警告
#DSH_CWD=/mnt/c/Users/deren
# 超时/命令也可在 AI 面板的 DSH 设置里改（存 .settings-dsh.json，即时生效且优先于这里的 env）
# 冷启动预热：dsh 首调要 25~60s（Windows 侧缓存冷），热调仅约 5s。服务启动后台跑一发极小任务焐热缓存，
# 并每 DSH_KEEPALIVE_SEC 秒保温一次；设 0 关闭保温
#DSH_KEEPALIVE_SEC=300
